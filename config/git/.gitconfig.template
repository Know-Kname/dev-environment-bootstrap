[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = <your-name>
	email = <your-email>

[core]
	autocrlf = true
	excludesfile = ~/.gitignore_global
	editor = code --wait

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
